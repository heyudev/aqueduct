# Primary general-purpose model, 8×H20 tensor-parallel.
#
# Launch with:  make up-model MODEL=primary
#
# Every number here is a starting point derived from H20's characteristics
# (see docs/hardware.md), NOT a measured optimum. Re-tune after running
# `make bench` on the real machine.

# --- what to serve ----------------------------------------------------------
# Local path inside the container. MODEL_DIR on the host is mounted at /models.
# Confirm the exact upstream repo and its FP8 variant before downloading; model
# releases move fast and this name may be outdated.
MODEL_PATH=/models/Qwen3-235B-A22B-Instruct-2507-FP8

# The name callers see. gateway/config.yaml maps aqueduct-chat onto this.
SERVED_MODEL_NAME=aqueduct-chat

# --- parallelism ------------------------------------------------------------
# All 8 GPUs, connected by NVLink. Do not exceed the GPU count on one host.
TP_SIZE=8

# --- memory budget ----------------------------------------------------------
# Fraction of each GPU's memory vLLM may claim. 0.92 leaves headroom for the
# CUDA context and NCCL buffers. Raise carefully; OOM shows up minutes into a
# load test, not at startup.
GPU_MEM_UTIL=0.92

# Context window. Larger means fewer concurrent requests fit in KV cache.
# 64k is a reasonable default for a general-purpose model; raise only if a real
# workload needs it, and re-measure concurrency afterwards.
MAX_MODEL_LEN=65536

# FP8 KV cache roughly halves KV memory versus fp16, buying ~2x concurrency at
# a small quality cost. Set to `auto` if you see quality regressions in eval.
KV_CACHE_DTYPE=fp8

# --- scheduling (the H20-specific part) -------------------------------------
# Tokens processed per scheduler step. H20 has ~1/7 of H100's compute, so the
# 8192-16384 values common in H100 configs make each step too slow and starve
# decoding. 4096 keeps prefill chunks small enough to interleave smoothly.
# Tune by watching TTFT vs TPOT under load.
MAX_NUM_BATCHED_TOKENS=4096

# Max concurrent sequences. Bounded by KV cache in practice; this is a safety
# ceiling so the scheduler does not admit more work than memory allows.
MAX_NUM_SEQS=64

# --- extra flags ------------------------------------------------------------
# --enable-expert-parallel distributes MoE experts across GPUs instead of
#   replicating them; usually a win for large MoE models on 8 cards.
# --trust-remote-code is required by some model repos that ship custom code.
#   Only enable it for repos you have reviewed and trust.
EXTRA_ARGS=--enable-expert-parallel
