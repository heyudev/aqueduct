# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   make env
#
# Generate the secrets below with something like:
#   python3 -c "import secrets; print('sk-aq-' + secrets.token_urlsafe(32))"

# ---- gateway ---------------------------------------------------------------

# Admin key for the LiteLLM proxy. Grants full control: minting keys, reading
# all usage, changing config. Treat it like a root password — it is not the key
# you hand to callers.
LITELLM_MASTER_KEY=

# Where the gateway listens. 127.0.0.1 exposes it to this host only; change to
# 0.0.0.0 once you are ready to accept traffic from the internal network, and
# only behind a firewall rule that limits source addresses.
GATEWAY_BIND=127.0.0.1

POSTGRES_USER=aqueduct
POSTGRES_DB=aqueduct
POSTGRES_PASSWORD=

# ---- inference backends ----------------------------------------------------

# Shared secret between the gateway and vLLM. vLLM has no per-caller quota, so
# this key exists purely to ensure nothing but the gateway can reach it.
VLLM_API_KEY=

# aqctl passes this to every instance it starts.
#
# Backend addresses are NOT configured here — they come from cluster.yaml and
# are written into gateway/config.yaml by `make apply`.

# ---- single-host debugging -------------------------------------------------
#
# Read only by `make up-model`, the bypass path for verifying one machine
# before adding it to cluster.yaml. Normal operation ignores these.

# Host directory holding downloaded model weights. Must be on fast local NVMe —
# weight loading is I/O bound. Cluster operation uses model_dir in cluster.yaml
# instead; keep the two consistent.
MODEL_DIR=/data/models

# Bind address and port for vLLM. Keep it off 0.0.0.0 unless a firewall
# restricts access to the gateway host.
VLLM_BIND=127.0.0.1
VLLM_PORT=8000

# Shared memory for tensor-parallel workers. The docker default of 64MB causes
# a silent hang at startup.
SHM_SIZE=64gb

# Pin to a tag you have actually tested. `latest` is not reproducible.
VLLM_IMAGE_TAG=latest

# Only needed for gated model repos on Hugging Face.
HF_TOKEN=

# ---- monitoring and console -------------------------------------------------

MONITORING_BIND=127.0.0.1
GRAFANA_PASSWORD=

# Gateway base URL. Used by the console for the usage tab and by smoke.sh.
AQ_URL=http://127.0.0.1:4000

# Links shown in the console's top bar. Both are OPTIONAL and neither is
# inferred — leave one empty and its link simply does not appear.
#
# Set them to the real addresses, and re-check after any port change. A URL
# that points at whatever else happens to occupy that port sends people to an
# unrelated service, and nothing on the page tells them the link is wrong.
#
# Grafana: historical trends and alerting. The console only keeps a short
# in-memory window, so this is where the long view lives.
GRAFANA_URL=

# The gateway's own admin UI: minting and revoking keys, the full ledger.
# For LiteLLM this is usually AQ_URL + /ui, but confirm it rather than assume.
GATEWAY_ADMIN_URL=
